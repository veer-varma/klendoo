# Klendoo — local environment template.
# Copy to .env and fill in real values locally. Never commit .env (see .gitignore).
# In CI/VPS these are populated from GitHub Actions secrets / the VPS's own .env —
# see Klendoo_Environment_Handoff_FROM_MANUS.md for the names already provisioned there.

# Postgres connection string used by packages/db (Prisma)
DATABASE_URL="postgresql://klendoo:password@localhost:5432/klendoo?schema=public"

# Which Algorand network payment-core's x402 resource server settles
# against. Default is testnet — do NOT switch to mainnet without fresh
# written authorization (see Manus's Claude Development Handoff, 2026-08-17:
# "Mainnet ... Explicitly not authorized. Requires successful TestNet
# settlement and fresh written authorization.").
ALGOD_NETWORK="testnet"

# GoPlausible x402 facilitator base URL. The public facilitator needs no API
# key for verify/settle as a resource server (confirmed against the official
# @x402/express example) — this only needs overriding for local testing
# against a different facilitator.
FACILITATOR_URL="https://facilitator.goplausible.xyz"

# Klendoo's own receiving wallet for x402 payments (the "master/manager"
# wallet, per Veer's wallet model — separate from every person's own
# custodial wallet). Required by services/followup-reminder-agent's server.
KLENDOO_PAYTO_ADDRESS=""

# Intermezzo (custodial wallets, Vault-backed) — see Manus's Claude
# Development Handoff, 2026-08-17. Klendoo code talks only to the scoped
# gateway, never raw Intermezzo/Vault. INTERMEZZO_GATEWAY_URL isn't
# finalized yet as of that handoff.
INTERMEZZO_GATEWAY_URL=""
KLENDOO_INTERMEZZO_API_KEY=""

# Default per-action settlement price in USDC, overridable via the PlatformSetting
# table at runtime — this env var is only a local-dev fallback when no DB is reachable.
DEFAULT_ACTION_PRICE_USDC="0.15"

# Postmark — used by services/followup-reminder-agent. The Sprint Plan assumed
# SendGrid; the actual provisioned environment uses Postmark instead.
POSTMARK_SERVER_API_TOKEN=""
POSTMARK_FROM_EMAIL="ops@klendoo.com"
