# Klendoo — local environment template.
# Copy to .env and fill in real values locally. Never commit .env (see .gitignore).
# In CI/VPS these are populated from GitHub Actions secrets / the VPS's own .env —
# see Klendoo_Environment_Handoff_FROM_MANUS.md for the names already provisioned there.

# Postgres connection string used by packages/db (Prisma)
DATABASE_URL="postgresql://klendoo:password@localhost:5432/klendoo?schema=public"

# Which Algorand network payment-core settles against.
# Sprint 0/1 default is testnet — do not switch to mainnet until the Ops Agent
# confirms the mainnet wallet is funded (see Development Plan, Milestone 1 timeline).
ALGOD_NETWORK="testnet"

# GoPlausible x402 facilitator API key for the selected network.
# Provisioned by the Ops Agent; corresponds to ALGOD_TESTNET_MNEMONIC in the
# GitHub Actions secret inventory for testnet.
GOPLAUSIBLE_API_KEY=""

# Default per-action settlement price in USDC, overridable via the PlatformSetting
# table at runtime — this env var is only a local-dev fallback when no DB is reachable.
DEFAULT_ACTION_PRICE_USDC="0.15"

# Postmark — used by services/followup-reminder-agent. The Sprint Plan assumed
# SendGrid; the actual provisioned environment uses Postmark instead.
POSTMARK_SERVER_API_TOKEN=""
POSTMARK_FROM_EMAIL="ops@klendoo.com"
