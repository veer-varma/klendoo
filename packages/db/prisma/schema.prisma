// Klendoo — schema.
//
// Sprint 0/1 scope note: started deliberately minimal per Klendoo_Sprint_Plan.md
// — "just ClientInteraction-style settlement logging, not the full TrustEdge
// model yet". TrustEdge, HostAccount, ClientAccessRequest, and a real User
// entity are still not here — that's the "entrepreneur piece" / host
// registration sprint, later than the scheduling work below.
//
// Sprint 2 adds SchedulingPoll/PollSlot/PollInvitee/PollResponse/CalendarEvent
// (Agent 2, Negotiation) — per Veer's 2026-08-17 direction: no Google Calendar
// OAuth yet (deferred), Klendoo's own calendar is the source of truth for now.
// Host identity there stays plain fields (hostName/hostEmail), matching the
// Reminder agent's BookingContext pattern.
//
// Sprint 4 adds Plan and HostAccount — real host registration/approval, per
// Veer's 2026-08-17 direction: plans and pricing must be admin-configurable
// data (Plan rows), never hardcoded constants — same principle already
// applied to action pricing via PlatformSetting.
//
// Sprint 5b adds TrustEdge — Agent 4 (Trust/Confidence engine), matching
// Klendoo_Product_Definition_Trust_Graph_Spec.md §1 exactly: one relational
// table with an edgeType discriminator, not a graph database, not three
// separate tables per layer. fromId/toId are plain strings (not foreign
// keys) on purpose — per the spec, "the trusted party: client email or
// User.id" — and matches every other identity field in this schema still
// being plain strings pending the "connect HostAccount to the agents"
// follow-up (see BACKLOG.md).
//
// Sprint 6a adds MagicLinkToken — real host-facing login, per Veer's
// 2026-08-18 direction ("I want all hosts to have a sign in page"). A host
// is a different person per account, so this is a magic-link email (via
// Postmark, already built) rather than the admin surface's single shared
// password — a shared password only makes sense for the one solo admin.
//
// Sprint 6b adds Contact (name + phone, per Veer's direction) and a real
// hostId on SchedulingPoll — the first time a host's own dashboard creates
// polls tied to their account instead of the CLI-only seedPolls.ts path.
// hostId is optional/nullable on purpose: existing CLI-seeded polls have no
// HostAccount row behind them, and the negotiation-agent's own paid
// endpoint still doesn't require one — this only wires the new
// host-dashboard's writes, it doesn't retrofit history.
//
// Contact intentionally has no email field even though poll invitations are
// still sent by email (Postmark) — Veer's request was specifically "name
// and phone number", with email/voice as future channels. A host inviting
// a saved contact to a poll today still has to type that person's email at
// invite time; see BACKLOG.md "Contacts are phone-only but invites are
// email-only" for the open product question this raises.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cross-cutting config, keyed by name — used for the default per-action
/// settlement price ($0.15) so payment-core never hardcodes it, per the
/// pricing correction in the Trust Graph Spec §4.
model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

enum InteractionStatus {
  PENDING
  SETTLED
  FAILED
}

/// One row per priced action attempt. This is the Sprint 0/1 stand-in for the
/// full ClientInteraction entity in the trust graph spec — same table name and
/// intent, trimmed to only what settlement logging needs right now. `contextRef`
/// is a free-form pointer to whatever booking/context record triggered the
/// action (a manually-seeded test record is fine for Sprint 1, per the plan).
model ClientInteraction {
  id         String             @id @default(cuid())
  actionType String
  amount     Decimal            @db.Decimal(10, 4)
  currency   String             @default("USDC")
  network    String             @default("algorand-testnet")
  status     InteractionStatus  @default(PENDING)
  txnHash    String?
  contextRef String?
  createdAt  DateTime           @default(now())
  settledAt  DateTime?

  @@index([status])
  @@map("client_interactions")
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
  FINALIZED
  CANCELLED
}

/// A scheduling coordination request — Agent 2 (Negotiation)'s Sprint 2 slice.
///
/// Lifecycle: DRAFT (built, not yet paid/sent) -> OPEN (paid, invitees
/// notified, awaiting responses) -> CLOSED (deadline passed, majority
/// computed — Sprint 3 also adds reconsideration outreach here) ->
/// FINALIZED (a CalendarEvent exists) | CANCELLED.
model SchedulingPoll {
  id            String     @id @default(cuid())
  hostName      String
  hostEmail     String
  /// Sprint 6b — set when a host dashboard (as opposed to the CLI seed
  /// path) creates the poll. See the Sprint 6b doc comment above for why
  /// this is nullable rather than a required migration of existing rows.
  hostId        String?
  title         String
  deadline      DateTime
  status        PollStatus @default(DRAFT)
  /// Set once CLOSED — the slot id majority-of-responders picked (earliest
  /// slot wins a tie). Not a foreign key on purpose: keeping it a plain id
  /// avoids a circular relation with PollSlot.
  winningSlotId String?
  createdAt     DateTime   @default(now())
  openedAt      DateTime?
  closedAt      DateTime?

  host      HostAccount?   @relation(fields: [hostId], references: [id])
  slots     PollSlot[]
  invitees  PollInvitee[]
  responses PollResponse[]
  event     CalendarEvent?

  @@index([status])
  @@index([hostId])
  @@map("scheduling_polls")
}

/// One candidate meeting time for a poll.
model PollSlot {
  id        String   @id @default(cuid())
  pollId    String
  startTime DateTime
  endTime   DateTime

  poll      SchedulingPoll @relation(fields: [pollId], references: [id])
  responses PollResponse[]

  @@index([pollId])
  @@map("poll_slots")
}

/// One invited person for a poll. `token` is the unguessable id in their
/// response link — deliberately not the poll id itself, so one invitee
/// can't see or affect another's response via a shared/guessed URL.
model PollInvitee {
  id               String    @id @default(cuid())
  pollId           String
  name             String
  email            String
  token            String    @unique @default(cuid())
  respondedAt      DateTime?
  /// Sprint 3 scope — set when the "most people picked a time you can't
  /// make, can you reconsider?" follow-up goes out.
  reconsiderSentAt DateTime?

  poll      SchedulingPoll @relation(fields: [pollId], references: [id])
  responses PollResponse[]

  @@index([pollId])
  @@map("poll_invitees")
}

/// One invitee's answer for one slot. Availability is captured per slot,
/// not as a single pick, because a majority needs to be computed across
/// everyone's answers — an invitee who's free for 3 of 4 candidate times
/// can't be represented by picking just one.
model PollResponse {
  id        String  @id @default(cuid())
  pollId    String
  slotId    String
  inviteeId String
  available Boolean

  poll    SchedulingPoll @relation(fields: [pollId], references: [id])
  slot    PollSlot       @relation(fields: [slotId], references: [id])
  invitee PollInvitee    @relation(fields: [inviteeId], references: [id])

  @@unique([slotId, inviteeId])
  @@map("poll_responses")
}

/// The confirmed meeting once a poll finalizes (Sprint 3 writes these;
/// modeled now so the relation exists from the start). `attendees` is a
/// simple comma-separated list for this slice — normalizing into its own
/// table is later scope once real usage shows it's needed.
model CalendarEvent {
  id        String   @id @default(cuid())
  hostEmail String
  title     String
  startTime DateTime
  endTime   DateTime
  attendees String
  pollId    String?  @unique
  createdAt DateTime @default(now())

  poll SchedulingPoll? @relation(fields: [pollId], references: [id])

  @@index([hostEmail])
  @@map("calendar_events")
}

/// A pricing tier hosts can be on — admin-configurable data, not a hardcoded
/// constant, per Veer's explicit direction (2026-08-17): "these should be
/// configurable from the superadmin interface, because we could then do
/// discounts etc." `billingInterval` is a plain string, not an enum, for
/// the same reason `ActionType`/`PollStatus` neighbors stay data-shaped
/// where a real admin might need a new value without a migration.
model Plan {
  id              String   @id @default(cuid())
  /// Stable machine reference (e.g. "starter", "entrepreneur") — the
  /// display name and price can change without breaking anything that
  /// refers to a host's plan by key.
  key             String   @unique
  name            String
  priceUsd        Decimal  @db.Decimal(10, 2)
  /// "one_time" | "monthly" — plain string on purpose, see above.
  billingInterval String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hosts HostAccount[]

  @@map("plans")
}

enum HostStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A registered host. This is the first real account identity in the
/// schema — everything before this (BookingContext, SchedulingPoll) used
/// plain hostName/hostEmail fields because there was nothing to reference.
/// Existing agents are NOT migrated to reference this yet (out of scope for
/// this slice) — that's a follow-up once the registration flow is real.
model HostAccount {
  id                   String     @id @default(cuid())
  businessName         String
  email                String     @unique
  /// Used in future public URLs (klendoo.com/{slug}) — reserved now so it's
  /// validated/unique from day one, not retrofitted once the booking page exists.
  slug                 String     @unique
  planId               String
  status               HostStatus @default(PENDING)
  /// Null until billing actually runs — see billing/ (stubbed this slice,
  /// no live Stripe account provisioned yet).
  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// Null until the host completes their first magic-link sign-in and sets
  /// one (Sprint 7a) — a host with no password yet can only sign in via
  /// magic link; once set, password becomes the normal path and magic link
  /// stays available as a fallback. scrypt-derived (see
  /// @klendoo/host-auth/password.ts), never a plaintext or emailed value —
  /// per Veer's 2026-08-22 direction, hosts set their own password after
  /// their first magic-link visit rather than being emailed one.
  passwordHash         String?
  createdAt            DateTime   @default(now())
  approvedAt           DateTime?

  plan            Plan             @relation(fields: [planId], references: [id])
  magicLinkTokens MagicLinkToken[]
  contacts        Contact[]
  polls           SchedulingPoll[]

  @@index([status])
  @@map("host_accounts")
}

/// A host's saved contact — name + phone number only, per Veer's explicit
/// 2026-08-18 direction, and the seed of the future voice-controlled flow
/// ("the host simply speaks and the app confirms its understanding"). See
/// the Sprint 6b doc comment at the top of this file for why this has no
/// email field even though today's poll invitations are still email-only.
model Contact {
  id        String   @id @default(cuid())
  hostId    String
  name      String
  phone     String
  createdAt DateTime @default(now())

  host HostAccount @relation(fields: [hostId], references: [id])

  @@unique([hostId, phone])
  @@index([hostId])
  @@map("contacts")
}

enum TrustEdgeType {
  APPROVAL
  RELATIONSHIP
  AUTONOMY
}

/// One trust relationship: does `fromId` trust `toId` enough for
/// `actionType`, right now — a one-hop question, per the spec's own
/// reasoning for why this is one table and not a graph database. Usage is
/// tracked (recordEdgeUsage) so confidenceScore can eventually be derived
/// from real repeat-interaction data, not asserted.
///
/// Written to by Reminder/Negotiation today (see recordEdgeUsage calls in
/// their agents) but nothing yet *reads* confidenceScore to gate behavior
/// — the spec is explicit that the 0.8/0.5 thresholds are an unvalidated
/// starting assumption, to be checked against real usage before anything
/// downstream depends on them. This table exists to make that validation
/// possible later, not to claim it's already validated.
model TrustEdge {
  id              String        @id @default(cuid())
  fromId          String
  toId            String
  edgeType        TrustEdgeType
  /// Plain string, not FK to any enum — matches actionType elsewhere
  /// (ClientInteraction, PaymentOption.extra) staying data-shaped.
  actionType      String
  confidenceScore Float         @default(0)
  reasoning       String?
  usageCount      Int           @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime      @default(now())
  revokedAt       DateTime?
  revokedReason   String?

  @@unique([fromId, toId, actionType])
  @@index([fromId])
  @@map("trust_edges")
}

/// A one-time login link sent to a host's email. Single-use (usedAt) and
/// short-lived (expiresAt) — a stateless signed token alone can't enforce
/// "only usable once," which matters for a login link specifically (an
/// intercepted link should stop working after first use, not stay valid
/// until it merely expires).
model MagicLinkToken {
  id        String    @id @default(cuid())
  hostId    String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  host HostAccount @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@map("magic_link_tokens")
}
